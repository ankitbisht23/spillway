{
  "realm": "spillway",
  "enabled": true,
  "roles": {
    "realm": [
      { "name": "viewer", "description": "Reads everything except the audit log (CP-12)" },
      { "name": "editor", "description": "Edits the config working set and imports (CP-12)" },
      { "name": "publisher", "description": "Publishes and rolls back config (CP-12)" },
      { "name": "key-admin", "description": "Consumers, API keys, overrides and access lists (CP-12)" },
      { "name": "admin", "description": "Everything, including tenants and the audit log (CP-12)" }
    ]
  },
  "clients": [
    {
      "clientId": "admin-ui",
      "name": "Spillway admin UI",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": ["http://localhost:5173/*", "http://localhost:8080/*"],
      "webOrigins": ["http://localhost:5173", "http://localhost:8080"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*##http://localhost:8080/*"
      },
      "protocolMappers": [
        {
          "name": "audience spillway-controlplane",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.custom.audience": "spillway-controlplane", "access.token.claim": "true", "id.token.claim": "false", "introspection.token.claim": "true" }
        }
      ]
    },
    {
      "clientId": "spillway-ci",
      "name": "CI and make verify-m5 (service token, CP-11)",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "dev-only-not-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "audience spillway-controlplane",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.custom.audience": "spillway-controlplane", "access.token.claim": "true", "id.token.claim": "false", "introspection.token.claim": "true" }
        }
      ]
    },
    {
      "clientId": "rbac-tests",
      "name": "Dev only: logs the test users in with their passwords for the RBAC tests (CP-12)",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "dev-only-not-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "protocolMappers": [
        {
          "name": "audience spillway-controlplane",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.custom.audience": "spillway-controlplane", "access.token.claim": "true", "id.token.claim": "false", "introspection.token.claim": "true" }
        }
      ]
    },
    {
      "clientId": "gateway-tests",
      "name": "Gateway tests (mints test JWTs, GW-18)",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "dev-only-not-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "audience spillway-gateway",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.custom.audience": "spillway-gateway", "access.token.claim": "true", "id.token.claim": "false", "introspection.token.claim": "true" }
        }
      ]
    }
  ],
