# Dev-only values for the kind cluster (ADR-0075 §D10). make kind-up creates
# a Secret named dev-secrets from this file in each namespace, by reference
# (kubectl create secret --from-env-file), and never prints it. Every value
# is the obviously fake dev value that .gitleaks.toml allowlists; nothing
# here comes from .env.local or .env.demo.
POSTGRES_PASSWORD=dev-only-not-secret
SPILLWAY_CP_DATABASE_PASSWORD=dev-only-not-secret
REDIS_PASSWORD=dev-only-not-secret
KEYCLOAK_ADMIN_PASSWORD=dev-only-not-secret
GRAFANA_ADMIN_PASSWORD=dev-only-not-secret
SPILLWAY_HEAVY_HITTER_SECRET=dev-only-not-secret
SPILLWAY_CI_CLIENT_SECRET=dev-only-not-secret
