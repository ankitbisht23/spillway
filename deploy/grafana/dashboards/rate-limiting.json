    {
      "id": 5,
      "type": "timeseries",
      "title": "Failure-mode decisions",
      "description": "Policies decided by their failure mode because Redis failed or timed out (RL-23): fail_open (allowed), fail_closed (503).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
