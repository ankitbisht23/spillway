      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (policy, decision) (rate(gw_ratelimit_decisions_total{replica=~\"$replica\",policy=~\"$policy\",decision!~\"allow|deny\"}[$__rate_interval]))",
          "legendFormat": "{{policy}} {{decision}}",
          "range": true
