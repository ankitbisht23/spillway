    {
      "id": 13,
      "type": "timeseries",
      "title": "Check latency by backend",
      "description": "gw_ratelimit_check_duration_seconds: each local phase, or all of a request's Redis calls (budget 5 ms, RL-22).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 43,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.005
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le, backend) (rate(gw_ratelimit_check_duration_seconds_bucket{replica=~\"$replica\"}[$__rate_interval])))",
          "legendFormat": "p99 {{backend}}",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le, backend) (rate(gw_ratelimit_check_duration_seconds_bucket{replica=~\"$replica\"}[$__rate_interval])))",
          "legendFormat": "p50 {{backend}}",
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
