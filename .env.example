# Dev defaults for the compose stack; make dev passes this file to docker compose
# with --env-file. Every value is obviously fake and safe to commit.
# Override locally in .env.local (gitignored, dev-safe values only); real secrets
# live only in .env.demo and your password manager (docs/setup.md Step 8).
# Secrets reach services only from env or mounted files, never config (SEC-09).
# Every Spillway secret setting X can instead be given as X_FILE, the path of a
# file that holds the value (one trailing newline trimmed); setting both, or an
# unreadable or empty file, stops the process. Files are read once at start;
# only TLS files reload (ADR-0040). Processes log a secret as [redacted] only.

# Postgres (user and database: spillway)
POSTGRES_PASSWORD=dev-only-not-secret

# Control plane (ADR-0036, ADR-0040): the app role spillway_app's password.
# controlplane migrate sets it on the role; the control plane logs in with it.
# It can instead be given as a file path in SPILLWAY_CP_DATABASE_PASSWORD_FILE (SEC-09).
SPILLWAY_CP_DATABASE_PASSWORD=dev-only-not-secret

# Keycloak admin console: http://localhost:8180/auth/admin/ (user: admin).
# The realm's test users and its client secrets are in
# deploy/compose/keycloak/realm.json, with the same fake value.
KEYCLOAK_ADMIN_PASSWORD=dev-only-not-secret

# The spillway-ci client's secret (ADR-0040): the integration tests and make
# verify-m5 get an admin service token with it. Unset, they use this value.
SPILLWAY_CI_CLIENT_SECRET=dev-only-not-secret

# Grafana: http://localhost:3000 (user: admin)
GRAFANA_ADMIN_PASSWORD=dev-only-not-secret

# Gateway Redis AUTH (SEC-09, ADR-0040): not set here, because the compose
# Redis Cluster has no password (ADR-0035 P11). A Redis with requirepass or an
# ACL user takes SPILLWAY_GATEWAY_REDIS_PASSWORD (or _FILE) and, for an ACL
# user, the non-secret SPILLWAY_GATEWAY_REDIS_USERNAME.

# The config stream's mTLS keys are files, not env: make certs writes them to
# deploy/stream-certs (gitignored), and compose mounts each container's own
# directory (SEC-02, ADR-0040).

# Not set here: SPILLWAY_REDIS_ADDR_MAP. The Makefile sets it for processes run
# on the host (ADR-0004); never put it in .env.local, which every container reads.
# Nor SPILLWAY_GATEWAY_REDIS_ADDRS and SPILLWAY_GATEWAY_DEV_MODE: compose.yaml sets
# them on the gateways (ADR-0021).

# Gateway shutdown (GW-23, ADR-0030): after SIGTERM a gateway keeps serving with
# /readyz failing for the drain, then gives in-flight requests the grace, so
# stopping or restarting a gateway takes at least the drain. compose.yaml's
# stop_grace_period (30s) must stay above drain + grace + 5s.
SPILLWAY_GATEWAY_DRAIN=5s
SPILLWAY_GATEWAY_SHUTDOWN_GRACE=15s

# Gateway load shedding (GW-26, ADR-0030): past these per-replica caps a
# gateway answers 503 with Retry-After: 1 at once instead of queueing. The
# admin port is exempt. compose.yaml's ulimits.nofile (65536) must stay well
# above MAX_CONNECTIONS plus the upstream connections.
SPILLWAY_GATEWAY_MAX_CONNECTIONS=8192
SPILLWAY_GATEWAY_MAX_IN_FLIGHT=4096

# Gateway trace head sampling (OB-02, ADR-0030): dev samples every trace and
# the OTel Collector tail-samples. The checks that measure latency (make
# verify-m1, -m2, -m3, accuracy and the Redis chaos tests) export 0.01, the
# benchmarks' fixed ratio, which overrides this.
SPILLWAY_GATEWAY_TRACE_SAMPLE_RATIO=1
